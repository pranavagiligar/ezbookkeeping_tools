# ====================================================================
# MoneyPath - ezBookkeeping Geotag Route Animator Configuration
# ====================================================================

# ezBookkeeping API Base URL (e.g. https://my-books.example.com or http://localhost:8080)
BASE_URL=https://your-ezbookkeeping-instance.com

# ezBookkeeping API Token (Preferred: generate in User Settings -> Security -> Generate Token)
API_TOKEN=your_api_bearer_token

# Alternatively, use username and password session authentication:
LOGIN_NAME=
PASSWORD=

# Port to serve the MoneyPath web application
PORT=8081

# Default animation fixed phase duration in seconds (e.g. 15, 30, 60)
DEFAULT_ANIMATION_DURATION=30

# Optional: Path to an MBTiles file for offline tiles. If set, MoneyPath will
# serve tiles from this file at /tiles/{z}/{x}/{y}.png. If unset, you can also
# place pre-rendered tiles under ./tiles/{z}/{x}/{y}.png and select "Local Tiles"
# in the UI.
# Example:
MBTILES_PATH=tiles.mbtiles

# Optional: Carto API Key for Dark Map tiles
CARTO_API_KEY=

